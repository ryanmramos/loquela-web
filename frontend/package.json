{
  "name": "loquela-web",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node --test tools/architecture-rules.spec.mjs && node tools/check-architecture.mjs",
    "proxy:check": "node tools/check-proxy.mjs",
    "bundle:check": "node tools/check-bundle-budgets.mjs",
    "e2e": "npm run build && playwright test --config playwright.production.config.ts",
    "e2e:dev": "playwright test",
    "e2e:edge": "node tools/edge-smoke.mjs",
    "e2e:safari": "node tools/safari-smoke.mjs",
    "edge:prepare:check": "node --test tools/prepare-caddy-artifact.spec.mjs",
    "api:generate": "node tools/generate-api.mjs",
    "api:check": "node --test tools/openapi-contract.spec.mjs && node tools/check-generated-api.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "secrets:check": "node --test tools/secret-scan.spec.mjs && node tools/secret-scan.mjs",
    "licenses:check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;Custom: LICENSE.md' --summary && node tools/check-custom-licenses.mjs",
    "verify": "npm run lint && npm run format:check && npm run architecture:check && npm run api:check && npm run secrets:check && npm run edge:prepare:check && npm test -- --watch=false && npm run build && npm run bundle:check && npm run proxy:check"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "22.0.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@primeui/license-manager": "^1.0.0",
    "@primeuix/themes": "^3.0.0",
    "lucide": "^1.28.0",
    "primeng": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "angular-eslint": "22.0.0",
    "eslint": "10.8.0",
    "jsdom": "^28.0.0",
    "license-checker-rseidelsohn": "5.0.1",
    "ng-openapi-gen": "1.0.5",
    "prettier": "3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.0.8"
  }
}
