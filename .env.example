# Copy this file to .env and replace local-only values as needed.
# Never commit .env or any real credentials.

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_MEDIA_ALLOWED_HOSTS=api.twilio.com
TWILIO_MEDIA_REDIRECT_ALLOWED_HOSTS=mms.twiliocdn.com
WHATSANKI_PUBLIC_BASE_URL=
WHATSANKI_DATA_ENCRYPTION_KEY=

# Google OAuth and browser sessions
SPRING_PROFILES_ACTIVE=local
WHATSANKI_GOOGLE_OAUTH_ENABLED=false
WHATSANKI_LOCAL_LOGIN_ENABLED=true
WHATSANKI_FRONTEND_BASE_URL=http://localhost:4200
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECT_URI=http://localhost:4200/login/oauth2/code/google
WHATSANKI_SECURE_COOKIES=false
WHATSANKI_SESSION_TIMEOUT=PT8H
# Keep blank for same-origin development. Use exact origins only when cross-origin development is unavoidable.
WHATSANKI_ALLOWED_ORIGINS=
WHATSANKI_AUTH_REQUESTS_PER_MINUTE=30
WHATSANKI_LINK_REQUESTS_PER_MINUTE=20

# PostgreSQL
POSTGRES_DB=whatsanki
POSTGRES_USER=whatsanki
POSTGRES_PASSWORD=whatsanki-local-only
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/whatsanki
SPRING_DATASOURCE_USERNAME=whatsanki
SPRING_DATASOURCE_PASSWORD=whatsanki-local-only

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=whatsanki-local
MINIO_ROOT_PASSWORD=whatsanki-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=whatsanki-local
OBJECT_STORE_ACCESS_KEY=whatsanki-local
OBJECT_STORE_SECRET_KEY=whatsanki-local-password
OBJECT_STORE_PATH_STYLE=true
OBJECT_STORE_PRESIGNED_URL_LIFETIME=PT15M

# Dictionary
# Provider IDs are selected at startup; "fake" is deterministic local test data only.
DICTIONARY_PROVIDER=wiktionary
# RAE is eligible only for es:es; the router skips it for every other pair and uses
# Wiktionary. A genuine RAE 404 falls through, while outages and throttling do not.
DICTIONARY_PROVIDER_ORDER=rae,wiktionary
RAE_API_KEY=
DICTIONARY_RAE_BASE_URL=https://rae-api.com
DICTIONARY_RAE_ALLOWED_HOSTS=rae-api.com
DICTIONARY_WIKTIONARY_BASE_URL_TEMPLATE=https://{definitionLanguage}.wiktionary.org/w/api.php
DICTIONARY_WIKTIONARY_ALLOWED_HOSTS=en.wiktionary.org,es.wiktionary.org
DICTIONARY_CONNECT_TIMEOUT=PT3S
DICTIONARY_READ_TIMEOUT=PT8S
DICTIONARY_MAX_RESPONSE_BYTES=1048576
DICTIONARY_MAX_CONCURRENT_REQUESTS=4
DICTIONARY_BASE_URL=
DICTIONARY_API_KEY=
DICTIONARY_USER_AGENT=WhatsAnki/0.1 (contact: you@example.com)

# Ingestion and jobs
WHATSANKI_MAX_DOWNLOAD_BYTES=15728640
WHATSANKI_MAX_EXTRACTED_CHARACTERS=2000000
WHATSANKI_MAX_PDF_PAGES=2000
# Used by authenticated EPUB web upload; WhatsApp still accepts PDF only.
WHATSANKI_MAX_EPUB_ENTRIES=10000
WHATSANKI_UPLOAD_INTENT_LIFETIME=PT15M
WHATSANKI_MULTIPART_MAX_FILE_SIZE=15MB
WHATSANKI_MULTIPART_MAX_REQUEST_SIZE=16MB
WHATSANKI_MAX_PASSAGE_CHARACTERS=1200
WHATSANKI_MAX_PASSAGE_TOKENS=250
WHATSANKI_MAX_PASSAGE_SENTENCES=3
WHATSANKI_SEARCH_MAX_TERM_CHARACTERS=256
WHATSANKI_SEARCH_MAX_RESULTS=20
WHATSANKI_SEARCH_CANDIDATE_MULTIPLIER=5
WHATSANKI_SEARCH_MAX_CANDIDATES=100
WHATSANKI_SEARCH_IDEAL_PASSAGE_CHARACTERS=320
WHATSANKI_SEARCH_LOOKUP_RESULTS=5
WHATSANKI_SEARCH_LOOKUP_MAX_RESULTS_PER_SOURCE=2
WHATSANKI_SEARCH_MAX_DICTIONARY_SEARCH_TERMS=32
WHATSANKI_OUTBOUND_MAX_MESSAGE_CHARACTERS=1500
WHATSANKI_OUTBOUND_MAX_LOOKUP_PARTS=10
WHATSANKI_EXTRACTION_TIMEOUT=PT1M
WHATSANKI_EXTRACTION_THREADS=2
WHATSANKI_MEDIA_CONNECT_TIMEOUT=PT10S
WHATSANKI_MEDIA_READ_TIMEOUT=PT30S
WHATSANKI_JOBS_POLL_INTERVAL=PT1S
WHATSANKI_JOBS_LEASE_DURATION=PT5M
WHATSANKI_JOBS_ENABLED=true
WHATSANKI_JOBS_BATCH_SIZE=10
WHATSANKI_JOBS_DEFAULT_MAX_ATTEMPTS=3
WHATSANKI_JOBS_MAX_PAYLOAD_BYTES=4096
WHATSANKI_JOBS_RETRY_BASE_DELAY=PT5S
WHATSANKI_JOBS_RETRY_MAX_DELAY=PT15M

# YouTube subtitle ingestion (install/pin yt-dlp separately; see docs/architecture/YT_DLP_CONFIGURATION.md)
WHATSANKI_YOUTUBE_EXECUTABLE=yt-dlp
# Set this to the exact output of `yt-dlp --version` in production.
WHATSANKI_YOUTUBE_EXPECTED_VERSION=
WHATSANKI_YOUTUBE_AUTOMATIC_CAPTION_FALLBACK=true
WHATSANKI_YOUTUBE_PROCESS_TIMEOUT=PT1M
WHATSANKI_YOUTUBE_MAX_METADATA_BYTES=1048576
WHATSANKI_YOUTUBE_MAX_SUBTITLE_BYTES=5242880
WHATSANKI_YOUTUBE_MAX_CAPTURED_ERROR_BYTES=16384
WHATSANKI_YOUTUBE_MAX_CAPTION_CUES=50000
WHATSANKI_YOUTUBE_PLAYBACK_LEAD=PT3S

# Python/genanki exporter
WHATSANKI_EXPORTER_PYTHON_EXECUTABLE=python3
WHATSANKI_EXPORTER_MODULE=whatsanki_exporter
WHATSANKI_EXPORTER_WORKING_DIRECTORY=exporter
WHATSANKI_EXPORTER_TIMEOUT=PT2M
WHATSANKI_EXPORTER_MAX_ARTIFACT_BYTES=104857600

# Retention
WHATSANKI_RETENTION_INBOUND_BODY=P7D
WHATSANKI_RETENTION_ORIGINAL_DOCUMENT=P30D
WHATSANKI_RETENTION_LOOKUP_SESSION=PT30M
WHATSANKI_RETENTION_EXPORT_ARTIFACT=PT24H
WHATSANKI_RETENTION_SCAN_INTERVAL=PT1H
WHATSANKI_RETENTION_SCAN_BATCH_SIZE=100

# Languages
WHATSANKI_DEFAULT_SOURCE_LANGUAGE=es
WHATSANKI_DEFAULT_DEFINITION_LANGUAGE=en
# Enabled pairs must be a subset of the selected provider's advertised capabilities.
WHATSANKI_SUPPORTED_LANGUAGE_PAIRS=es:en,en:es,es:es,en:en
