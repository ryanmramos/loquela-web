{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Loquela Browser API",
    "description" : "Authenticated, DTO-only browser contracts under /api/v1. Twilio webhooks are\nintentionally excluded. Enums use string values. Collection endpoints use opaque\ncursor pagination. Clients may send X-Correlation-ID; the server always returns the\neffective value. Retriable create commands use Idempotency-Key. Versioned mutations\nuse If-Match and return the new ETag.\n",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same-origin browser API"
  } ],
  "security" : [ {
    "browserSession" : [ ]
  } ],
  "paths" : {
    "/api/v1/sources" : {
      "get" : {
        "tags" : [ "browser-source-controller" ],
        "summary" : "List the authenticated user's sources",
        "operationId" : "listSources",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "pageSize",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 50,
            "minimum" : 1
          }
        }, {
          "name" : "search",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 256,
            "minLength" : 0
          }
        }, {
          "name" : "kind",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "PASTED_TEXT", "TXT", "PDF", "EPUB", "YOUTUBE_VIDEO" ]
          }
        }, {
          "name" : "status",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "RECEIVED", "FETCHING", "STORED", "EXTRACTING", "INDEXING", "READY", "FAILED", "DELETING", "DELETED" ]
          }
        }, {
          "name" : "sort",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "CREATED_AT",
            "enum" : [ "CREATED_AT", "UPDATED_AT", "DISPLAY_NAME" ]
          }
        }, {
          "name" : "direction",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "DESC",
            "enum" : [ "ASC", "DESC" ]
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Source page",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SourceListDto"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "browser-source-controller" ],
        "summary" : "Create a pasted-text source",
        "operationId" : "createPastedTextSource",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreatePastedTextSourceRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Source accepted for indexing",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PastedTextSourceDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/{sourceReference}/retry" : {
      "post" : {
        "tags" : [ "browser-source-controller" ],
        "summary" : "Retry a backend-declared retryable source",
        "operationId" : "retrySource",
        "parameters" : [ {
          "name" : "sourceReference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Retry accepted",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SourceMutationDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/youtube" : {
      "post" : {
        "tags" : [ "browser-source-controller" ],
        "summary" : "Create a YouTube subtitle source",
        "operationId" : "createYouTubeSource",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateYouTubeSourceRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Source accepted",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AcceptedSourceDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/source-uploads" : {
      "post" : {
        "tags" : [ "browser-source-upload-controller" ],
        "summary" : "Create a one-time document upload intent",
        "operationId" : "createSourceUpload",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateSourceUploadRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Upload intent",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SourceUploadIntentDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/source-uploads/{uploadReference}/complete" : {
      "post" : {
        "tags" : [ "browser-source-upload-controller" ],
        "summary" : "Upload and finalize a document once",
        "operationId" : "completeSourceUpload",
        "parameters" : [ {
          "name" : "uploadReference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary"
                  }
                },
                "required" : [ "file" ]
              }
            }
          }
        },
        "responses" : {
          "202" : {
            "description" : "Document accepted",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AcceptedSourceDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/logout" : {
      "post" : {
        "tags" : [ "browser-session-controller" ],
        "summary" : "Invalidate the current browser session",
        "operationId" : "logoutBrowserSession",
        "responses" : {
          "204" : {
            "description" : "Session invalidated"
          }
        }
      }
    },
    "/api/v1/lookups" : {
      "post" : {
        "tags" : [ "browser-lookup-controller" ],
        "summary" : "Queue a contextual lookup",
        "operationId" : "createBrowserLookup",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateBrowserLookupRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Lookup accepted",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserLookupAcceptedDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lookups/{lookupReference}/contexts/{contextNumber}/save" : {
      "post" : {
        "tags" : [ "browser-lookup-controller" ],
        "summary" : "Save one lookup context as a card",
        "operationId" : "saveBrowserLookupContext",
        "parameters" : [ {
          "name" : "lookupReference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "contextNumber",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SaveLookupResultRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Saved card reference",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserLookupSaveDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cards" : {
      "get" : {
        "tags" : [ "browser-card-controller" ],
        "summary" : "List owned cards",
        "operationId" : "listBrowserCards",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "pageSize",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 50,
            "minimum" : 1
          }
        }, {
          "name" : "search",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 256,
            "minLength" : 0
          }
        }, {
          "name" : "deckReference",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Card page",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserCardListDto"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "browser-card-controller" ],
        "summary" : "Create a card",
        "operationId" : "createBrowserCard",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CardMutationRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created card",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserCardDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/{sourceReference}" : {
      "get" : {
        "tags" : [ "browser-source-controller" ],
        "summary" : "Get an owned source",
        "operationId" : "getSource",
        "parameters" : [ {
          "name" : "sourceReference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Source details",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserSourceDetailsDto"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "browser-source-controller" ],
        "summary" : "Queue deletion of an owned source",
        "operationId" : "deleteSource",
        "parameters" : [ {
          "name" : "sourceReference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Deletion accepted",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SourceMutationDto"
                }
              }
            }
          }
        }
      },
      "patch" : {
        "tags" : [ "browser-source-controller" ],
        "summary" : "Rename an owned source",
        "operationId" : "renameSource",
        "parameters" : [ {
          "name" : "sourceReference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RenameSourceRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Renamed source",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserSourceSummaryDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/languages" : {
      "get" : {
        "tags" : [ "browser-language-settings-controller" ],
        "summary" : "Return the current and supported source/definition language pairs",
        "operationId" : "getBrowserLanguageSettings",
        "responses" : {
