{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Loquela Browser API",
    "description" : "Authenticated, DTO-only browser contracts under /api/v1. Twilio webhooks are\nintentionally excluded. Enums use string values. Collection endpoints use opaque\ncursor pagination. Clients may send X-Correlation-ID; the server always returns the\neffective value. Retriable create commands use Idempotency-Key. Versioned mutations\nuse If-Match and return the new ETag.\n",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same-origin browser API"
  } ],
  "security" : [ {
    "browserSession" : [ ]
  } ],
  "paths" : {
    "/api/v1/sources" : {
      "post" : {
        "tags" : [ "browser-source-controller" ],
        "summary" : "Create a pasted-text source",
        "operationId" : "createPastedTextSource",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreatePastedTextSourceRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Source accepted for indexing",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PastedTextSourceDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/logout" : {
      "post" : {
        "tags" : [ "browser-session-controller" ],
        "summary" : "Invalidate the current browser session",
        "operationId" : "logoutBrowserSession",
        "responses" : {
          "204" : {
            "description" : "Session invalidated"
          }
        }
      }
    },
    "/api/v1/session" : {
      "get" : {
        "tags" : [ "browser-session-controller" ],
        "summary" : "Return the current authenticated browser session",
        "operationId" : "getBrowserSession",
        "responses" : {
          "200" : {
            "description" : "Authenticated session",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserSessionDto"
                }
              }
            }
          },
          "401" : {
            "description" : "No authenticated browser session",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dashboard" : {
      "get" : {
        "tags" : [ "dashboard-controller" ],
        "summary" : "Return the authenticated dashboard aggregate",
        "operationId" : "getDashboard",
        "responses" : {
          "200" : {
            "description" : "Dashboard aggregate",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DashboardDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google" : {
      "get" : {
        "tags" : [ "browser-authentication-controller" ],
        "summary" : "Start Google sign-in with a validated frontend return path",
        "operationId" : "startGoogleLogin",
        "parameters" : [ {
          "name" : "returnTo",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "302" : {
            "description" : "Redirect to Spring Security's Google authorization endpoint"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreatePastedTextSourceRequestDto" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string",
            "maxLength" : 2000000,
            "minLength" : 0
          }
        },
        "required" : [ "text" ]
      },
      "PastedTextSourceDto" : {
        "type" : "object",
        "properties" : {
          "sourceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "reference" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "RECEIVED" ]
          },
          "characterCount" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "characterCount", "reference", "sourceId", "status" ]
      },
      "BrowserSessionDto" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "sourceLanguage" : {
            "type" : "string"
          },
          "definitionLanguage" : {
            "type" : "string"
          },
          "accountState" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "DELETING" ]
          },
          "linkedAccounts" : {
            "$ref" : "#/components/schemas/LinkedAccountsDto"
          }
        },
        "required" : [ "accountState", "definitionLanguage", "linkedAccounts", "sourceLanguage", "userId" ]
      },
      "LinkedAccountsDto" : {
        "type" : "object",
        "properties" : {
          "google" : {
            "type" : "boolean"
          },
          "whatsapp" : {
            "type" : "boolean"
          }
        },
        "required" : [ "google", "whatsapp" ]
      },
      "ApiProblemDto" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "code" : {
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string"
          },
          "correlationId" : {
            "type" : "string"
          },
          "fieldErrors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required" : [ "code", "correlationId", "fieldErrors", "status", "title", "type" ]
      },
      "FieldErrorDto" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "field", "message" ]
      },
      "ActivityItem" : {
        "type" : "object",
        "properties" : {
          "kind" : {
            "type" : "string",
            "enum" : [ "SOURCE", "JOB" ]
          },
          "title" : {
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "occurredAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "target" : {
            "type" : "string"
          }
        },
        "required" : [ "detail", "kind", "occurredAt", "status", "target", "title" ]
      },
      "ActivitySummary" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "AVAILABLE", "UNAVAILABLE" ]
          },
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ActivityItem"
            }
          }
        },
        "required" : [ "items", "status" ]
      },
      "CardSummary" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "AVAILABLE", "UNAVAILABLE" ]
          },
          "cardsToStudy" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          },
          "totalCards" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          },
          "newCardsThisWeek" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          }
        },
        "required" : [ "cardsToStudy", "newCardsThisWeek", "status", "totalCards" ]
      },
      "DashboardDto" : {
        "type" : "object",
        "properties" : {
          "generatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "languagePair" : {
            "$ref" : "#/components/schemas/LanguagePair"
          },
          "cards" : {
            "$ref" : "#/components/schemas/CardSummary"
          },
          "sources" : {
            "$ref" : "#/components/schemas/SourceSummary"
          },
          "jobs" : {
            "$ref" : "#/components/schemas/JobSummary"
          },
          "activity" : {
            "$ref" : "#/components/schemas/ActivitySummary"
          }
        },
        "required" : [ "activity", "cards", "generatedAt", "jobs", "languagePair", "sources" ]
      },
      "JobSummary" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "AVAILABLE", "UNAVAILABLE" ]
          },
          "activeJobs" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          }
        },
        "required" : [ "activeJobs", "status" ]
      },
      "LanguagePair" : {
        "type" : "object",
        "properties" : {
          "sourceLanguage" : {
            "type" : "string"
          },
          "definitionLanguage" : {
            "type" : "string"
          }
        },
        "required" : [ "definitionLanguage", "sourceLanguage" ]
      },
      "SourceSummary" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "AVAILABLE", "UNAVAILABLE" ]
          },
          "totalSources" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          },
          "readySources" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          },
          "processingSources" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          }
        },
        "required" : [ "processingSources", "readySources", "status", "totalSources" ]
      }
    },
    "securitySchemes" : {
      "browserSession" : {
        "type" : "apiKey",
        "name" : "LOQUELA_SESSION",
        "in" : "cookie"
      }
    }
  }
}
