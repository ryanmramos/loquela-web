              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserLanguageSettingsDto"
                }
              }
            }
          }
        }
      },
      "patch" : {
        "tags" : [ "browser-language-settings-controller" ],
        "summary" : "Update the source and definition languages for future work",
        "operationId" : "updateBrowserLanguageSettings",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateLanguageSettingsRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Updated language settings",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserLanguageSettingsDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/interface-language" : {
      "patch" : {
        "tags" : [ "browser-session-controller" ],
        "summary" : "Persist the browser interface language",
        "operationId" : "updateInterfaceLanguage",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateInterfaceLanguageRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserSessionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cards/{reference}" : {
      "get" : {
        "tags" : [ "browser-card-controller" ],
        "summary" : "Get an owned card",
        "operationId" : "getBrowserCard",
        "parameters" : [ {
          "name" : "reference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Card",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserCardDto"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "browser-card-controller" ],
        "operationId" : "delete",
        "parameters" : [ {
          "name" : "reference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      },
      "patch" : {
        "tags" : [ "browser-card-controller" ],
        "summary" : "Update an owned card",
        "operationId" : "updateBrowserCard",
        "parameters" : [ {
          "name" : "reference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CardMutationRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Updated card",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserCardDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session" : {
      "get" : {
        "tags" : [ "browser-session-controller" ],
        "summary" : "Return the current authenticated browser session",
        "operationId" : "getBrowserSession",
        "responses" : {
          "200" : {
            "description" : "Authenticated session",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserSessionDto"
                }
              }
            }
          },
          "401" : {
            "description" : "No authenticated browser session",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lookups/{lookupReference}" : {
      "get" : {
        "tags" : [ "browser-lookup-controller" ],
        "summary" : "Get an owned lookup snapshot",
        "operationId" : "getBrowserLookup",
        "parameters" : [ {
          "name" : "lookupReference",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Current lookup state",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BrowserLookupDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lookups/decks" : {
      "get" : {
        "tags" : [ "browser-lookup-controller" ],
        "summary" : "List active decks available for lookup cards",
        "operationId" : "listBrowserLookupDecks",
        "responses" : {
          "200" : {
            "description" : "Active deck options",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/BrowserDeckOptionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dashboard" : {
      "get" : {
        "tags" : [ "dashboard-controller" ],
        "summary" : "Return the authenticated dashboard aggregate",
        "operationId" : "getDashboard",
        "responses" : {
          "200" : {
            "description" : "Dashboard aggregate",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DashboardDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google" : {
      "get" : {
        "tags" : [ "browser-authentication-controller" ],
        "summary" : "Start Google sign-in with a validated frontend return path",
        "operationId" : "startGoogleLogin",
        "parameters" : [ {
          "name" : "returnTo",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "302" : {
            "description" : "Redirect to Spring Security's Google authorization endpoint"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreatePastedTextSourceRequestDto" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string",
            "maxLength" : 2000000,
            "minLength" : 0
          }
        },
        "required" : [ "text" ]
      },
      "PastedTextSourceDto" : {
        "type" : "object",
        "properties" : {
          "sourceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "reference" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "RECEIVED" ]
          },
          "characterCount" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "characterCount", "reference", "sourceId", "status" ]
      },
      "SourceMutationDto" : {
        "type" : "object",
        "properties" : {
          "reference" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "RECEIVED", "FETCHING", "STORED", "EXTRACTING", "INDEXING", "READY", "FAILED", "DELETING", "DELETED" ]
          },
          "jobReference" : {
            "type" : "string"
          }
        },
        "required" : [ "reference", "status" ]
      },
      "CreateYouTubeSourceRequestDto" : {
        "type" : "object",
        "properties" : {
          "url" : {
            "type" : "string",
            "maxLength" : 2048,
            "minLength" : 0
          }
        },
        "required" : [ "url" ]
      },
      "AcceptedSourceDto" : {
        "type" : "object",
        "properties" : {
          "reference" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "RECEIVED", "FETCHING", "STORED", "EXTRACTING", "INDEXING", "READY", "FAILED", "DELETING", "DELETED" ]
          },
          "existing" : {
            "type" : "boolean"
          }
        },
        "required" : [ "existing", "reference", "status" ]
      },
      "CreateSourceUploadRequestDto" : {
        "type" : "object",
        "properties" : {
          "fileName" : {
            "type" : "string",
            "maxLength" : 512,
            "minLength" : 0
          },
          "mediaType" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          },
          "size" : {
            "type" : "integer",
            "format" : "int64"
          },
          "sha256" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "^[0-9a-fA-F]{64}$"
          }
        },
        "required" : [ "fileName", "mediaType", "sha256" ]
      },
      "SourceUploadIntentDto" : {
        "type" : "object",
        "properties" : {
          "uploadReference" : {
            "type" : "string"
          },
          "uploadMode" : {
            "type" : "string",
            "enum" : [ "APPLICATION" ]
          },
          "completionPath" : {
            "type" : "string"
          },
          "maxBytes" : {
            "type" : "integer",
            "format" : "int64"
          },
          "acceptedMediaTypes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
